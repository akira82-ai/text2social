{
  "manifest_version": 3,
  "name": "Text2Social",
  "version": "1.0",
  "description": "Convert selected text to social media images",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/dompurify.min.js",
        "lib/mustache.min.js",
        "js/text-selection.js",
        "js/icon-display.js",
        "js/template-manager.js",
        "js/preview-renderer.js",
        "js/image-exporter.js",
        "content.js"
      ],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}